# block palette - keep the count in sync with #n in load.mcfunction
execute if score #h gb matches 0 run return run setblock ~ ~ ~ minecraft:stone keep
execute if score #h gb matches 1 run return run setblock ~ ~ ~ minecraft:grass_block keep
execute if score #h gb matches 2 run return run setblock ~ ~ ~ minecraft:dirt keep
execute if score #h gb matches 3 run return run setblock ~ ~ ~ minecraft:oak_log keep
execute if score #h gb matches 4 run return run setblock ~ ~ ~ minecraft:oak_leaves[persistent=true] keep
execute if score #h gb matches 5 run return run setblock ~ ~ ~ minecraft:sand keep
execute if score #h gb matches 6 run return run setblock ~ ~ ~ minecraft:gravel keep
execute if score #h gb matches 7 run return run setblock ~ ~ ~ minecraft:cobblestone keep
execute if score #h gb matches 8 run return run setblock ~ ~ ~ minecraft:coal_ore keep
execute if score #h gb matches 9 run return run setblock ~ ~ ~ minecraft:copper_ore keep
execute if score #h gb matches 10 run return run setblock ~ ~ ~ minecraft:iron_ore keep
execute if score #h gb matches 11 run return run setblock ~ ~ ~ minecraft:gold_ore keep
execute if score #h gb matches 12 run return run setblock ~ ~ ~ minecraft:clay keep
execute if score #h gb matches 13 run return run setblock ~ ~ ~ minecraft:andesite keep
execute if score #h gb matches 14 run return run setblock ~ ~ ~ minecraft:diorite keep
execute if score #h gb matches 15 run return run setblock ~ ~ ~ minecraft:granite keep
